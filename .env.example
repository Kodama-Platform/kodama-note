# Skip password / KNP encryption and save workbooks in localStorage (UI polish).
# Unset: on in `npm run dev`, off in production builds.
# Set false to force the encrypted place flow in development.
# Set true explicitly to enable plaintext mode in a production build.
VITE_PLAINTEXT_MODE=

VITE_DONATE_URL="https://ko-fi.com/"

# Delivery Gate root. Notes are called at `{VITE_BACKEND_URL}/v1/notes`.
# Example: https://xxxx.supabase.co/functions/v1/delivery-gate
VITE_BACKEND_URL=

# Optional override if the notes base is not `{backend}/v1/notes`.
# VITE_NOTE_API_URL="https://api.kodama.com/v1/notes"

# Kodama ecosystem billing (shared). See docs/NOTE_API.md §3–4.
VITE_PAY_API_URL="https://api.kodama.com/v1/pay"

# Optional Bearer token for local /v1/pay calls. Prefer a real session later.
VITE_KODAMA_ACCOUNT_TOKEN=
